# CrateDB connection string
# Format: crate://[user]:[password]@[host]:[port]/[schema]
CRATE_DB_URL=crate://crate@localhost:4200

# Security (Change this in production to a long, random string!)
JWT_SECRET_KEY=your-very-secret-key-change-in-prod
JWT_EXPIRE_MINUTES=10080

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
